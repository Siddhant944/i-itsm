{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Bash(cat .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(grep .env)",
      "Bash(sed .env)",
      "Bash(awk .env)",
      "Bash(bat .env)",
      "Bash(cat backend/.env)",
      "Bash(head backend/.env)",
      "Bash(tail backend/.env)",
      "Bash(less backend/.env)",
      "Bash(more backend/.env)",
      "Bash(grep backend/.env)",
      "Bash(sed backend/.env)",
      "Bash(awk backend/.env)",
      "Bash(bat backend/.env)",
      "Bash(cat frontend/.env)",
      "Bash(head frontend/.env)",
      "Bash(tail frontend/.env)",
      "Bash(less frontend/.env)",
      "Bash(more frontend/.env)",
      "Bash(grep frontend/.env)",
      "Bash(sed frontend/.env)",
      "Bash(awk frontend/.env)",
      "Bash(bat frontend/.env)",
      "Bash(cat .env.local)",
      "Bash(head .env.local)",
      "Bash(tail .env.local)",
      "Bash(less .env.local)",
      "Bash(more .env.local)",
      "Bash(grep .env.local)",
      "Bash(sed .env.local)",
      "Bash(awk .env.local)",
      "Bash(bat .env.local)",
      "Bash(cat .env.production)",
      "Bash(head .env.production)",
      "Bash(tail .env.production)",
      "Bash(less .env.production)",
      "Bash(more .env.production)",
      "Bash(grep .env.production)",
      "Bash(sed .env.production)",
      "Bash(awk .env.production)",
      "Bash(bat .env.production)"
    ]
  }
}
