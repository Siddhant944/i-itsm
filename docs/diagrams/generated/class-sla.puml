@startuml class-sla
' GENERATED by backend/scripts/gen_diagrams.py from the code. Do not edit by hand:
' change the code (or the spec in the script) and run `make diagrams`.

!pragma layout smetana

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

top to bottom direction
title SLA policies, risk estimation and escalation (Strategy, Chain of Responsibility)

class SLAPolicyBook {
  +policies : Mapping[tuple[SLATier, Priority], SLATarget] {readOnly}
  +target_for(tier, priority) : SLATarget
  +target_or_default(tier, priority) : tuple[SLATarget, bool]
}
class SLATarget <<value object>> {
  +response : timedelta
  +resolution : timedelta
  {static} +checked(response, resolution) : SLATarget
  +scaled(factor) : SLATarget
}
interface RiskEstimator {
  {abstract} +is_at_risk(elapsed, target) : bool
}
class ThresholdRiskEstimator {
  +fraction : float {readOnly}
  +is_at_risk(elapsed, target) : bool
}
class HistoricalRiskEstimator {
  +is_at_risk(elapsed, target) : bool
  +estimate(elapsed, target) : RiskEstimate
}
class EscalationHandler {
  +role : Role {readOnly}
  +successor : EscalationHandler | None {readOnly}
  +handle(required_level, reason) : EscalationDecision
}
class EscalationDecision <<value object>> {
  +level : int
  +target_role : Role
  +reason : str
}
ThresholdRiskEstimator ..|> RiskEstimator
HistoricalRiskEstimator ..|> RiskEstimator
SLAPolicyBook o-- "0..*" SLATarget : policies
EscalationHandler --> "0..1" EscalationHandler : successor
EscalationHandler ..> EscalationDecision : <<returns>>
note bottom of EscalationHandler
  Chain: Technician -> TeamLead -> Administrator
  -> ITManager. Each handler passes the request on
  until one has the required level.
end note
@enduml
