!pragma layout smetana

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

top to bottom direction
title Priority and assignment engines (Strategy, Template Method)

abstract class PriorityStrategy {
  +name : str
  +assess(impact, urgency, criticality, floor) : PriorityAssessment
}
class WeightedProductPriorityStrategy {
}
class MatrixPriorityStrategy {
  +table : Mapping[tuple[int, int], Priority] {readOnly}
  +DEFAULT_TABLE : Mapping[tuple[int, int], Priority]
}
class PriorityAssessment <<value object>> {
  +priority : Priority
  +score : int | None
  +explanation : str
  +floored : bool
}
abstract class AssignmentStrategy {
  +select(request, candidates) : tuple[CandidateScore, ...]
  {abstract} +rank(request, eligible) : list[CandidateScore]
}
class SkillBasedStrategy {
  +rank(request, eligible) : list[CandidateScore]
}
class LoadBasedStrategy {
  +rank(request, eligible) : list[CandidateScore]
}
class SmartStrategy {
  +weights : tuple[float, float, float, float] {readOnly}
  +rank(request, eligible) : list[CandidateScore]
}
class AssignmentRequest <<value object>> {
  +priority : Priority
  +required_skills : SkillSet
  +service_id : int
}
class Candidate <<value object>> {
  +technician : Technician
  +load : int
  +past_fixes : int
}
class CandidateScore <<value object>> {
  +technician_id : int
  +score : float
  +reasons : tuple[str, ...]
}
WeightedProductPriorityStrategy --|> PriorityStrategy
MatrixPriorityStrategy --|> PriorityStrategy
SkillBasedStrategy --|> AssignmentStrategy
LoadBasedStrategy --|> AssignmentStrategy
SmartStrategy --|> AssignmentStrategy
PriorityStrategy ..> PriorityAssessment : <<returns>>
AssignmentStrategy ..> AssignmentRequest : select()
AssignmentStrategy ..> Candidate
AssignmentStrategy ..> CandidateScore : <<returns>>
note right of AssignmentStrategy
  Template Method: select() filters the candidates
  (available, active, under L_max) and calls the
  abstract rank() hook, where skills,
  load and experience decide the order.
end note
