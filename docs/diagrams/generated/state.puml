@startuml state
' GENERATED by backend/scripts/gen_diagrams.py from the code. Do not edit by hand:
' change the code (or the spec in the script) and run `make diagrams`.

!pragma layout smetana

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

title Incident lifecycle (State pattern): the transitions the code allows

state NEW : NewState
state CLASSIFIED : ClassifiedState
state ASSIGNED : AssignedState
state ACKNOWLEDGED : AcknowledgedState
state IN_PROGRESS : InProgressState
state ON_HOLD : OnHoldState
state RESOLVED : ResolvedState
state VERIFIED : VerifiedState
state CLOSED : ClosedState
state CANCELLED : CancelledState
[*] --> NEW : report
NEW --> CLASSIFIED : classify
NEW --> CANCELLED : cancel
CLASSIFIED --> ASSIGNED : assign / reassign / escalate
CLASSIFIED --> CANCELLED : cancel
ASSIGNED --> ASSIGNED : assign / reassign / escalate
ASSIGNED --> ACKNOWLEDGED : acknowledge
ASSIGNED --> CANCELLED : cancel
ACKNOWLEDGED --> ASSIGNED : assign / reassign / escalate
ACKNOWLEDGED --> IN_PROGRESS : start work
ACKNOWLEDGED --> CANCELLED : cancel
IN_PROGRESS --> ASSIGNED : assign / reassign / escalate
IN_PROGRESS --> ON_HOLD : request info / hold
IN_PROGRESS --> RESOLVED : resolve
IN_PROGRESS --> CANCELLED : cancel
ON_HOLD --> IN_PROGRESS : resume
ON_HOLD --> CANCELLED : cancel
RESOLVED --> VERIFIED : verify
RESOLVED --> IN_PROGRESS : reject fix
RESOLVED --> CLOSED : auto-close after 72 h
VERIFIED --> CLOSED : close
CLOSED --> [*]
CANCELLED --> [*]
note as N
  20 distinct (from, to) pairs; any other trigger raises
  InvalidStateTransitionError (409). CANCELLED is reachable from every
  non-terminal state up to ON_HOLD.
end note
@enduml
