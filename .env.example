# I-ITSM configuration. Copy to .env (never commit .env) and fill in what you need.
# Every variable read by backend/app/core/config.py is listed here; a test keeps them in sync.
# Empty optional values mean "use the fallback": rule-based AI, console email, no Telegram.

# --- application
APP_ENV=dev                      # dev | test | demo | prod
APP_NAME=I-ITSM
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./itsm.db # PostgreSQL: postgresql+psycopg://itsm:itsm@localhost:5432/itsm
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# --- auth (blueprint §8)
JWT_SECRET=                      # required when APP_ENV=prod; e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ACCESS_TTL_MINUTES=30
ALLOWED_EMAIL_DOMAINS=[]         # e.g. ["hyderabad.bits-pilani.ac.in"]; empty allows any email (D-008)

# --- clock (blueprint §5.2): system | accelerated (demo uses accelerated x10)
CLOCK_MODE=system           # system | accelerated (demo, x10) | fake (test/demo, moved by /dev/clock, D-009)
CLOCK_ACCELERATION=10
SLA_TICK_SECONDS=30         # the SLA monitor ticks every 30 s of clock time (D-003); 0 disables it

# --- Gemini (blueprint §6); from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# --- email (blueprint §5.4); leave SMTP_HOST empty to print emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=I-ITSM <no-reply@localhost>
SMTP_STARTTLS=true

# --- Telegram alerts (blueprint §5.4); from @BotFather
TELEGRAM_BOT_TOKEN=

# --- Google Sign-In (blueprint §8)
GOOGLE_CLIENT_ID=
GOOGLE_HD_DOMAIN=                # e.g. hyderabad.bits-pilani.ac.in

# --- frontend (read by Vite at build time)
VITE_API_URL=                    # empty = same origin (dev proxy / nginx)
VITE_GOOGLE_CLIENT_ID=
